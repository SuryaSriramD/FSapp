# Optional when running the single Docker application.
PORT=8080
# Canonical public HTTPS origin when behind a reverse proxy; no trailing slash.
FSAPP_PUBLIC_ORIGIN=http://localhost:8080
# Local Vite development origins. Leave empty in production.
FSAPP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Direct transfers work without TURN. Remote connectivity is best-effort until
# Cloudflare credentials are configured. Never put these values in VITE_* vars.
FSAPP_TURN_ENABLED=false
FSAPP_TURN_KEY_ID=
FSAPP_TURN_API_TOKEN=
FSAPP_MAX_ROOMS=500
FSAPP_MAX_CONNECTIONS=1000
FSAPP_CREATE_PER_MINUTE=20
FSAPP_REQUEST_PER_MINUTE=120
# Code guessing limits; keep conservative on public deployments.
FSAPP_PAIRING_ATTEMPTS_PER_MINUTE=5
FSAPP_PAIRING_GLOBAL_ATTEMPTS_PER_MINUTE=60
